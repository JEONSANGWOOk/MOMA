    },
    "loadmap_status": {
      "path": "all.loadmap_status",
      "optional": true
    },
    "block_x": {
      "path": "all.block_x",
      "optional": true
    },
    "block_y": {
      "path": "all.block_y",
      "optional": true
    },
    "mode": {
      "path": "all.mode",
      "optional": true
    }
