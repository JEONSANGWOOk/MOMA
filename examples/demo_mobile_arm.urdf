<?xml version="1.0"?>
<robot name="Demo Six Axis Arm">
  <material name="yellow"><color rgba="0.95 0.62 0.12 1"/></material>
  <material name="dark"><color rgba="0.22 0.28 0.36 1"/></material>
  <link name="arm_base"><visual><origin xyz="0 0 0.075"/><geometry><cylinder radius="0.11" length="0.15"/></geometry><material name="dark"/></visual></link>
  <link name="shoulder"><visual><origin xyz="0 0 0.09"/><geometry><box size="0.17 0.17 0.18"/></geometry><material name="yellow"/></visual></link>
  <joint name="joint_1" type="continuous"><origin xyz="0 0 0.15"/><parent link="arm_base"/><child link="shoulder"/><axis xyz="0 0 1"/></joint>
  <link name="upper_arm"><visual><origin xyz="0 0 0.19"/><geometry><cylinder radius="0.065" length="0.38"/></geometry><material name="yellow"/></visual></link>
  <joint name="joint_2" type="revolute"><origin xyz="0 0 0.18"/><parent link="shoulder"/><child link="upper_arm"/><axis xyz="0 1 0"/><limit lower="-2.4" upper="2.4" effort="100" velocity="1"/></joint>
  <link name="forearm"><visual><origin xyz="0 0 0.16"/><geometry><cylinder radius="0.055" length="0.32"/></geometry><material name="yellow"/></visual></link>
  <joint name="joint_3" type="revolute"><origin xyz="0 0 0.38"/><parent link="upper_arm"/><child link="forearm"/><axis xyz="0 1 0"/><limit lower="-2.7" upper="2.7" effort="100" velocity="1"/></joint>
  <link name="wrist_1"><visual><origin xyz="0 0 0.055"/><geometry><cylinder radius="0.07" length="0.11"/></geometry><material name="dark"/></visual></link>
  <joint name="joint_4" type="continuous"><origin xyz="0 0 0.32"/><parent link="forearm"/><child link="wrist_1"/><axis xyz="0 0 1"/></joint>
  <link name="wrist_2"><visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.05" length="0.10"/></geometry><material name="yellow"/></visual></link>
  <joint name="joint_5" type="revolute"><origin xyz="0 0 0.11"/><parent link="wrist_1"/><child link="wrist_2"/><axis xyz="0 1 0"/><limit lower="-2.4" upper="2.4" effort="20" velocity="1"/></joint>
  <link name="tool"><visual><origin xyz="0 0 0.06"/><geometry><box size="0.11 0.06 0.12"/></geometry><material name="dark"/></visual></link>
  <joint name="joint_6" type="continuous"><origin xyz="0 0 0.10"/><parent link="wrist_2"/><child link="tool"/><axis xyz="0 0 1"/></joint>
</robot>
